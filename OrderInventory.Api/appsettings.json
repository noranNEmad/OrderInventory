{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=OrderInventoryDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Issuer": "OrderInventory.Api",
    "Audience": "OrderInventory.Client",
    "ExpirationInMinutes": 30
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "AuthWindowSeconds": 60,
    "GeneralPermitLimit": 100,
    "GeneralWindowSeconds": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
