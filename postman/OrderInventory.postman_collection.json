        {
          "name": "Login (Auto-stores JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('jwt_token', data.token);",
                  "        console.log('JWT Token successfully saved into collection variable {{jwt_token}}');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@orderinventory.com\",\n  \"password\": \"P@ssword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user and executes a Postman Test Script to automatically store the JWT in {{jwt_token}}."
          },
          "response": []
        },
        {
          "name": "Get Current User Profile (/me)",
